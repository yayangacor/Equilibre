# Salin ke .env lalu isi nilainya. File .env tidak di-commit.

# Langflow (jalan lokal di laptop saat demo)
LANGFLOW_URL=http://127.0.0.1:7860
LANGFLOW_API_KEY=
# ID flow `analisis_status` (Langflow → Share → API access)
LANGFLOW_FLOW_ID=
# ID project `Equilibre` (tab MCP Server), dipakai untuk mendaftarkan MCP ke Bob
LANGFLOW_PROJECT_ID=

# Backend perantara
PORT=8787

# IBM Bob Shell: wajib untuk `bob run` headless (login interaktif tidak dipakai)
BOB_API_KEY=
# Opsional: lokasi bob.js (bawaan %APPDATA%/npm/node_modules/bobshell/dist/bob.js) dan folder kerja Bob
# (bawaan ../bob-workspace dari folder equilibre/)
# BOB_JS=
# BOB_WORKSPACE=

# Demo online lewat tunnel (NOTES D-80): server membuka pintu kedua di PUBLIC_PORT hanya kalau PROXY_SECRET
# terisi (≥ 32 karakter). Nilai yang sama diisi di Vercel sebagai BACKEND_SECRET; BACKEND_URL = https://<NGROK_DOMAIN>.
PROXY_SECRET=
PUBLIC_PORT=8788
# Domain tetap ngrok (dashboard.ngrok.com → Domains), tanpa https://
NGROK_DOMAIN=
# Server + Langflow di VPS, Ask Equi (Bob) tetap di laptop (NOTES D-98). Di VPS: ASK_FORWARD_URL = ujung tunnel SSH
# balik dari laptop (mis. http://127.0.0.1:18788) dan PROXY_SECRET yang sama dengan laptop. Di laptop: kosongkan
# ASK_FORWARD_URL, lalu `npm --prefix server run ask-tunnel` (alias SSH VPS_SSH_HOST, port ASK_TUNNEL_PORT di VPS).
ASK_FORWARD_URL=
VPS_SSH_HOST=equilibre-vps
ASK_TUNNEL_PORT=18788
